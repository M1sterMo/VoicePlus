<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/wholeWidget"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  tools:ignore="ContentDescription,HardcodedText">

  <ImageView
    android:id="@+id/widgetBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:src="@drawable/widget_background"
    android:scaleType="fitXY" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
      android:id="@+id/imageView"
      android:layout_width="wrap_content"
      android:layout_height="match_parent"
      android:adjustViewBounds="true"
      android:background="@drawable/widget_cover_preview"
      android:clipToOutline="true"
      android:scaleType="centerCrop"
      android:src="@drawable/album_art"
      tools:targetApi="31" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="The Count of Monte Cristo"
        android:textColor="@color/widget_text_primary"
        android:textSize="@dimen/widget_title_size" />

      <TextView
        android:id="@+id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Chapter 05 - Marseille"
        android:textColor="@color/widget_text_secondary"
        android:textSize="@dimen/widget_summary_size" />

      <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:maxHeight="4dp"
        android:minHeight="4dp"
        android:progress="40"
        android:progressDrawable="@drawable/widget_progress" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/previousChapter"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:layout_marginHorizontal="4dp"
          android:background="@drawable/widget_button_tonal"
          android:padding="8dp"
          android:src="@drawable/widget_ic_skip_previous"
          android:visibility="gone" />

        <ImageView
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:layout_marginHorizontal="4dp"
          android:background="@drawable/widget_button_tonal"
          android:padding="8dp"
          android:src="@drawable/widget_ic_replay" />

        <ImageView
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:layout_marginHorizontal="4dp"
          android:background="@drawable/widget_button_primary"
          android:padding="8dp"
          android:src="@drawable/widget_ic_play" />

        <ImageView
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:layout_marginHorizontal="4dp"
          android:background="@drawable/widget_button_tonal"
          android:padding="8dp"
          android:src="@drawable/widget_ic_forward" />

        <ImageView
          android:id="@+id/nextChapter"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:layout_marginHorizontal="4dp"
          android:background="@drawable/widget_button_tonal"
          android:padding="8dp"
          android:src="@drawable/widget_ic_skip_next"
          android:visibility="gone" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>

</FrameLayout>
